@model List<ASP_P42.Data.Entities.ProductGroup>
@{
    ViewData["Title"] = "Товарні групи";
}

<div class="text-center mb-4">
    <h1 class="display-4">Перелік товарних груп</h1>
    <p class="lead">Каталог наявних категорій товарів</p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12 text-center text-muted">
            <p>Групи товарів відсутні або приховані.</p>
        </div>
    }
    else
    {
        @foreach (var group in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    @if (!string.IsNullOrEmpty(group.ImageUrl))
                    {
                        <img src="@group.ImageUrl" class="card-img-top rounded-top-3" alt="@group.Name" style="height: 180px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded-top-3" style="height: 180px;">
                            <span class="fs-4">@group.Name</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@group.Name</h5>
                        <p class="card-text text-secondary">@group.Description</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <span class="badge bg-primary">Slug: @group.Slug</span>
                    </div>
                </div>
            </div>
        }
    }
</div>
